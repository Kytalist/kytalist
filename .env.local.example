# Base URL for the api-kytalist backend.
# Include the API version prefix (the routes live under /api/v1).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Supabase (browser client for /admin sign-in). Same Supabase project as api-kytalist.
# NEXT_PUBLIC_SUPABASE_URL — copy SUPABASE_URL from api-kytalist/.env (same string).
NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY — publishable key (sb_publishable_...) from
# Supabase Dashboard → Connect, or Settings → API Keys.
# Use the same Supabase project as api-kytalist (SUPABASE_URL / SUPABASE_ANON_KEY there).
# Never put SUPABASE_SERVICE_ROLE_KEY in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
