# Base URL for the api-kytalist backend.
# Include the API version prefix (the routes live under /api/v1).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Supabase (browser client for /admin sign-in). Same Supabase project as api-kytalist.
# NEXT_PUBLIC_SUPABASE_URL — copy SUPABASE_URL from api-kytalist/.env (same string).
NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY — anon/public key from Supabase Dashboard → Project Settings → API.
# api-kytalist/.env only has SUPABASE_SERVICE_ROLE_KEY (server-only); never put that in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
